# Supabase project URL (server only for the first integration stage)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Secret key. Store only in Netlify environment variables; never commit a real value.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Public key is only needed after browser authentication/RLS policies are implemented.
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
